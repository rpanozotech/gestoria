# =====================================================================
# NEXUSGEST - Plantilla de variables de entorno
# Copia a .env solo para desarrollo local. En produccion, define estas
# variables en Coolify > Environment Variables. NO subas .env al repo.
# =====================================================================

# --- OBLIGATORIAS ----------------------------------------------------

# Secreto de firma de los JWT (login del CRM/portal).
# Minimo 32 caracteres aleatorios. Generar con: openssl rand -hex 32
# Si lo cambias, todas las sesiones activas se invalidan.
JWT_SECRET=

# Contrasena de PostgreSQL.
# IMPORTANTE: solo [A-Za-z0-9] sin acentos. La cadena DATABASE_URL del
# backend se arma sin URL-encoding, asi que caracteres como @ : / ? # o
# espacios la rompen silenciosamente y el backend no conecta.
POSTGRES_PASSWORD=

# URL-encoded connection string used by the backend.
DATABASE_URL=postgresql://nexusgest_user:URL_ENCODED_PASSWORD@postgres:5432/nexusgest_db

# --- CORS ------------------------------------------------------------
# Dominios que pueden llamar al API directamente, separados por comas.
# El frontend normal va same-origin via la rewrite, asi que esto solo hace
# falta si consumes /api/backend/* desde otro host.
ALLOWED_ORIGINS=https://rp-gestoria.tech,https://www.rp-gestoria.tech

# --- BASE DE DATOS ---------------------------------------------------

POSTGRES_USER=nexusgest_user
POSTGRES_DB=nexusgest_db

# --- OPENAI / IA -----------------------------------------------------

# Opcional. Si se deja vacio, chat-IA, alta-IA y documentos-IA responden
# con un error de credenciales en lugar de generar contenido.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama en el mismo servidor. En Docker suele ser http://ollama:11434/v1;
# fuera de Docker puede ser http://127.0.0.1:11434/v1.
# Si la UI mantiene el proveedor OpenAI sin clave, el backend usara Ollama.
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=llama3:latest

# --- CREDENCIAL DEL ADMIN (solo para `npm run db:seed`) --------------
# El seed siembra datos de DEMO y, si defines SEED_ADMIN_PASSWORD, tambien un
# admin con esa contrasena. Sin la variable no crea usuario.
#
# En produccion NO ejecutes el seed. Crea tu gestor con:
#   npm run db:create-user -- --email gestor@rp-gestoria.tech --name "Rony P."
# que genera una contrasena aleatoria de 20 caracteres.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# --- SOLO DESARROLLO LOCAL -------------------------------------------
# Estas las define docker-compose.yml para ti. No ponerlas en Coolify.

# URL que usa el NAVEGADOR. Debe ser same-origin: el cliente no puede
# resolver el hostname `backend` de la red de Docker.
NEXT_PUBLIC_API_BASE=/api/backend
# URL que usa el SERVIOR de Next para proxear hacia el backend.
API_INTERNAL_URL=http://backend:5000
