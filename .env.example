# ==========================================
# NEXUSGEST - Configuración de Entorno (Coolify / Docker)
# ==========================================

# Entorno
NODE_ENV=production
PORT=5000

# Base de datos PostgreSQL
# En Coolify / Docker Compose, el host es el nombre del servicio 'postgres'
POSTGRES_USER=nexusgest_user
POSTGRES_PASSWORD=nexusgest_secret_password_2026
POSTGRES_DB=nexusgest_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nexusgest_user:nexusgest_secret_password_2026@postgres:5432/nexusgest_db

# Seguridad & Autenticación
JWT_SECRET=super_secret_jwt_key_nexusgest_secure_2026_change_in_production
JWT_EXPIRES_IN=7d

# OpenAI API (Para Alta por Lenguaje Natural, OCR y Generador de Cartas)
OPENAI_API_KEY=tu-api-key-de-openai-aqui
OPENAI_MODEL=gpt-4o-mini

# URLs Públicas (Configurar tus dominios en Coolify)
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Almacenamiento local para documentos
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15
