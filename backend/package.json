{
  "name": "nexusgest-backend",
  "version": "1.0.0",
  "description": "Backend API para NexusGest - Plataforma de Negocio & CRM Gestoria",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "db:init": "node dist/db/init.js",
    "db:seed": "node dist/db/seed.js",
    "db:create-user": "node dist/db/create-user.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.12.0",
    "tar": "^7.5.22",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2"
  }
}
